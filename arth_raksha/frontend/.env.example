VITE_ARTH_RAKSHA_API=http://localhost:8002
# Must match a key the backend accepts (ARTHDRISHTI_API_KEYS on the backend).
# Defaults to the same well-known dev key the backend falls back to when
# ARTHDRISHTI_API_KEYS isn't set — fine for local dev, not for production.
VITE_API_KEY=dev-local-key-not-for-production
