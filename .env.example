# Copy to .env (never commit real values). Backend reads these from the environment.

# --- Core -------------------------------------------------------------------
# development | production. In production the server refuses to start without
# JWT_SECRET + DATA_ENCRYPTION_KEY, and the public dev API key is disabled.
ARTHDRISHTI_ENV=development

# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Encrypts stored provider tokens (any long random string). Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=

# SQLite by default (zero setup). Use Postgres in production, e.g. Render's Internal Database URL.
# DATABASE_URL=postgresql://user:password@host:5432/arthdrishti
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API (required in production).
CORS_ALLOW_ORIGINS=http://localhost:5173

# Optional API-key login for the legacy /auth/token endpoint (comma-separated).
ARTHDRISHTI_API_KEYS=

# --- AI (optional; the app works without them) ---------------------------------
# Enables Claude vision for receipt OCR, LLM-worded explanations and chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OCR_MODEL=

# --- Crypto wallet data (works with no keys; keys just raise rate limits) --------
# Free CoinGecko "demo" key (https://www.coingecko.com/en/api) — recommended for production traffic.
COINGECKO_API_KEY=
# Ethereum indexer (defaults to the public Blockscout instance).
BLOCKSCOUT_API_URL=https://eth.blockscout.com/api/v2

# --- Arth Raksha (optional) -----------------------------------------------------
# Full wallet feature extraction for the ML scam signal. https://etherscan.io/apis
ETHERSCAN_API_KEY=
# Ethereum JSON-RPC endpoint (defaults to the free https://rpc.mevblocker.io)
ETH_RPC_URL=
NEO4J_PASSWORD=
